{
  "name": "nodejs-typescript-barebone",
  "version": "0.0.0",
  "description": "A minimalistic nodejs typescript project as a template.",
  "author": "Ilir Kosumi",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "format": "prettier . --write",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "typescript",
    "javascript",
    "NodeJS",
    "starter",
    "kit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ikosumi/nodejs-typescript-barebone.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
